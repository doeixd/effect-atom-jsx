    "reactivity",
    "jsx",
    "dom-expressions",
    "atoms",
    "todomvc",
    "typescript",
    "optimistic-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/effect-atom-jsx.git"
  },
  "homepage": "https://github.com/doeixd/effect-atom-jsx#readme",
  "bugs": {
    "url": "https://github.com/doeixd/effect-atom-jsx/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "test": "vitest run && npm run test:permissive",
    "test:permissive": "npm run test -w @affe/permissive",
    "typecheck:permissive": "tsc --noEmit -p packages/permissive/tsconfig.json",
    "build:permissive": "npm run build -w @affe/permissive",
    "test:watch": "vitest",
    "test:future": "vitest run --config vitest.future.config.ts",
    "test:all": "npm test && npm run test:future",
    "test:future:watch": "vitest --config vitest.future.config.ts",
    "typecheck:future": "tsc --noEmit -p tsconfig.future.json",
    "test:browser": "npm run build && npm run build:permissive && npm run build:resumable-example && npm run build:extract-example && npm run build:permissive-example && playwright test",
    "build:resumable-example": "node examples/resumable-action/build.mjs",
    "preview:resumable-example": "vite preview --config examples/resumable-action/vite.config.ts",
    "build:extract-example": "node examples/resumable-extract/build.mjs",
    "preview:extract-example": "vite preview --config examples/resumable-extract/vite.config.ts",
    "build:permissive-example": "node examples/permissive-demo/build.mjs",
    "preview:permissive-example": "vite preview --config examples/permissive-demo/vite.config.ts",
    "build:resumability-benchmark": "node examples/resumability-benchmark/build.mjs",
    "preview:resumability-benchmark": "vite preview --config examples/resumability-benchmark/vite.config.ts",
    "bench:resumability": "npm run build && npm run build:resumability-benchmark && node benchmarks/resumability/run.mjs",
    "bench:resumability:verify": "node benchmarks/resumability/verify.mjs bench-results/resumability/latest.json",
    "bench": "vitest bench --run",
    "bench:ci": "vitest bench --run --outputJson bench-results.json",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "typecheck:browser": "tsc --noEmit -p tsconfig.browser.json",
    "typecheck:effect": "effect-tsgo diagnostics --project tsconfig.build.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests && npm run typecheck:examples && npm run typecheck:browser && npm run typecheck:permissive && npm run typecheck:effect",
    "check": "npm run typecheck:all && npm run test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@typeonce/effect-machine": "0.1.0",
    "effect": "4.0.0-beta.102",
    "seroval": "^1.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@effect/tsgo": "^0.24.3",
    "@playwright/test": "^1.62.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "babel-plugin-jsx-dom-expressions": "^0.39.0",
    "jest": "^30.2.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.102"
  }
}
