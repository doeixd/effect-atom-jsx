{
  "//": "Type-checks src including __tests__ (the base config and build exclude tests). Run via `npm run typecheck:tests` (green under TypeScript 7). rootDir is relaxed so example-integration tests can import from examples/.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    // Mirrors the vitest alias: workspace adapter packages resolve to their
    // SOURCE under test (and the public core subpaths they consume resolve
    // to src/), so the suite never depends on a stale dist build.
    "paths": {
      "@affe/agent": ["./packages/agent/src/index.ts"],
      "effect-atom-jsx/Agent": ["./src/Agent.ts"]
    }
  },
  "include": ["src/**/*", "packages/agent/src/**/*"],
  "exclude": ["node_modules", "dist", "examples"]
}
