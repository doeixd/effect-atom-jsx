{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "jsxImportSource": "effect-atom-jsx",
    // The package consumes the published core surface, never src/. The
    // enforcement test in src/__tests__/spi-consumer.test.ts pins this.
    "plugins": []
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/__tests__/**/*"]
}
