{
  "name": "@affe/permissive",
  "version": "0.0.0",
  "description": "Qwik-parity preset for effect-atom-jsx: auto-capture + the universal seroval codec + the reference plugins as a configuration, not a fork. Doubles as the external-style adapter-SPI consumer.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "effect-atom-jsx": "file:../.."
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta"
  }
}
